{
  "name": "jibo-studio",
  "version": "0.1.0",
  "private": true,
  "description": "IDE for creating Jibo on-robot Electron skills",
  "license": "BSD-3-Clause",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jibo-studio/desktop",
    "build": "npm run build -w @jibo-studio/desktop",
    "package:linux": "npm run package:linux -w @jibo-studio/desktop",
    "vendor": "tsx scripts/vendor-from-pvindex.ts",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
