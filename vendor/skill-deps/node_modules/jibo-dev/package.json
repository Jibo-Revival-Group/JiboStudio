{
  "name": "jibo-dev",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "description": "Jibo build tools, dev dependencies",
  "main": "lib/jibo-dev.js",
  "bin": {
    "rulify": "./bin/rulify.js",
    "behaviorify": "./bin/behaviorify.js",
    "flowlint": "./bin/flowlint.js",
    "jibo-dev": "./bin/jibo-dev.js"
  },
  "scripts": {
    "build": "gulp debug",
    "build:release": "gulp",
    "clean": "gulp clean-all",
    "watch": "gulp watch",
    "test": "gulp test",
    "download": "npm run postinstall",
    "postinstall": "node postinstall.js",
    "docs": "gulp docs",
    "publish:patch": "gulp publish --yes --bump=patch",
    "publish:minor": "gulp publish --yes --bump=minor",
    "publish:major": "gulp publish --yes --bump=major",
    "publish:skip": "gulp publish --yes --bump=skip",
    "publish:release": "gulp release --yes --tag=beta"
  },
  "scriptsRelease": {
    "postinstall": "node postinstall.js"
  },
  "typings": "lib/dts/index.d.ts",
  "author": "Matt Karl <matt.karl@jibo.com>",
  "license": "UNLICENSED",
  "dependencies": {
    "browserify": "^13.1.1",
    "chalk": "^1.1.3",
    "colors": "^1.1.2",
    "del": "^2.2.2",
    "escodegen": "^1.6.1",
    "esprima": "^2.2.0",
    "estraverse": "^4.2.0",
    "find-root": "^1.0.0",
    "glob": "^7.0.3",
    "gulp": "^3.9.1",
    "gulp-if": "^2.0.2",
    "gulp-tslint": "^7.0.1",
    "gulp-uglify-harmony": "jiborobot/gulp-uglify-harmony#master",
    "jibo-flow-core": "^1.0.0",
    "mapstraction": "^1.0.0",
    "minimist": "^1.2.0",
    "mkdirp": "^0.5.1",
    "parser-download": "^2.0.0",
    "pretty-hrtime": "^1.0.3",
    "through2": "^2.0.1",
    "tsify-preprocess": "^2.0.3",
    "tslint": "^4.1.1",
    "typescript": "^2.1.4",
    "vinyl-buffer": "^1.0.0",
    "vinyl-source-stream": "^1.1.0",
    "watchify": "^3.8.0"
  },
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
  },
  "devDependencies": {
    "deepmerge": "^0.2.10",
    "eslint": "^3.4.0",
    "eslint-plugin-json": "^1.2.0",
    "gulp-comments": "^1.1.0",
    "jibo-gulp": "^3.0.0",
    "jsdoc": "^3.4.0",
    "jsdoc-jibo": "^1.0.0",
    "should": "^9.0.2"
  }
}
