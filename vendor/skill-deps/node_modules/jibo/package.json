{
  "name": "jibo",
  "version": "5.8.1",
  "description": "Runtime API for Jibo skills",
  "platform": ">=2.2.0",
  "main": "./lib/jibo.js",
  "typings": "dts/index.d.ts",
  "scripts": {
    "build": "gulp debug",
    "build:release": "gulp",
    "watch": "gulp watch",
    "test": "gulp test",
    "clean": "gulp clean release-clean",
    "predocs": "gulp comments",
    "docs": "jsdoc -c tasks/docs.json",
    "predocs:public": "gulp comments --exclude=@internal",
    "docs:public": "jsdoc -c tasks/docs-all.json",
    "paddle": "paddlejs -f ./paddleconfig.json -h",
    "paddle:debug": "paddlejs -f ./paddleconfig.json",
    "paddle:jenkins": "paddlejs -f ./paddleconfig.json -h -p",
    "publish:patch": "gulp publish --yes --bump=patch",
    "publish:minor": "gulp publish --yes --bump=minor",
    "publish:major": "gulp publish --yes --bump=major",
    "publish:skip": "gulp publish --yes --bump=skip",
    "publish:release": "gulp release --yes --tag=beta"
  },
  "dependencies": {
    "animation-utilities": "^2.3.0",
    "async": "^1.5.2",
    "callsite": "^1.0.0",
    "eases": "^1.0.8",
    "find-root": "^1.0.0",
    "hammerjs": "^2.0.8",
    "jibo-background": "^0.1.4",
    "jibo-client-framework": "^1.0.4",
    "jibo-eventemitter3": "^1.3.1",
    "jibo-flow-core": "^1.0.0",
    "jibo-kb": "^4.1.0",
    "jibo-keyframes": "^2.0.0",
    "jibo-log": "^2.0.0",
    "jibo-state-machine": "^3.2.0",
    "jibo-typed-events": "^3.1.1",
    "jibo-common-types": "^1.0.0",
    "orchestrator": "^0.3.7",
    "pixi-animate": "^1.0.1",
    "pixi.js": "^4.2.2",
    "semver": "^5.0.3",
    "uuid": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "glob": "^7.0.5",
    "glslify": "^5.1.0",
    "gulp": "^3.9.0",
    "gulp-comments": "^1.1.0",
    "jibo-dev": "^1.0.0",
    "jibo-gulp": "^3.1.1",
    "paddlejs": "^1.5.2",
    "jsdoc": "^3.4.0",
    "jsdoc-jibo": "^1.0.1",
    "should": "^8.1.1",
    "sinon": "^1.17.3"
  },
  "browserify": {
    "transform": [
      "glslify"
    ]
  }
}
