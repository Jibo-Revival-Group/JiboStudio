                "subflowId": "./sayHello",
                "inputParameters": ["() => { return { notepad: notepad }; }"],
                "getTransition": ["(r) => { return r.transition; }"]
            },
            "name": "sayHello"
        },
        {
            "class": "Flow.End",
            "clazz": "Flow.End",
            "loc": "200 320",
            "id": "end-1",
            "options": { "getTransition": ["() => { return ; }"] },
            "name": ""
        }
    ],
    "linkDataArray": [
        { "from": "begin-1", "to": "subflow-1", "fromPort": "", "toPort": "" },
        { "from": "subflow-1", "to": "end-1", "fromPort": "", "toPort": "" }
    ]
}
