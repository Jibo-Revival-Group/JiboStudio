    "linkFromPortIdProperty": "fromPort",
    "linkToPortIdProperty": "toPort",
    "nodeDataArray": [
        {
            "class": "Flow.Begin",
            "clazz": "Flow.Begin",
            "loc": "200 80",
            "id": "begin-1",
            "options": { "inputParameters": ["()=>{ return {}; }"] },
            "name": "Begin"
        },
        {
            "class": "Flow.Subflow",
            "clazz": "Flow.Subflow",
            "loc": "200 200",
