{
  "name": "jibo-emotion-system",
  "version": "2.3.5",
  "description": "Manages how Jibo appraises his environment and how it affects his internal state, as well as how he expresses that internal state",
  "main": "lib/jibo-emotion-system.js",
  "typings": "dts/main.d.ts",
  "scripts": {
    "dts": "gulp dts",
    "test:debug": "gulp test --debug",
    "test": "gulp test",
    "build": "gulp debug",
    "watch": "gulp watch",
    "build:release": "gulp",
    "clean": "gulp clean",
    "predocs": "gulp comments",
    "docs": "gulp docs",
    "predocs:public": "gulp comments --exclude=@internal",
    "docs:public": "gulp docs-public",
    "publish:patch": "gulp publish --yes --bump=patch",
    "publish:minor": "gulp publish --yes --bump=minor",
    "publish:major": "gulp publish --yes --bump=major",
    "publish:skip": "gulp publish --yes --bump=skip"
  },
  "dependencies": {
    "jibo-cai-utils": "^2.2.0",
    "jibo-action-system": "^4.0.0",
    "jibo-common-types": "^1.0.0",
    "jibo-typed-events": "^3.2.2"
  },
  "devDependencies": {
    "gulp": "^3.9.1",
    "jibo-dev": "^2.6.11",
    "jibo-gulp": "^3.6.1",
    "jibo-log": "^2.0.0",
    "typescript": "^2.2.2",
    "typescript-definition-tester": "0.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
