{
  "name": "jibo-log",
  "version": "2.6.3",
  "description": "Jibo console, filesystem, and syslog logging utility",
  "main": "index.js",
  "typings": "index.d.ts",
  "scripts": {
    "build": "gulp debug",
    "build:release": "gulp",
    "test": "gulp test",
    "watch": "gulp watch",
    "clean": "gulp clean-all",
    "docs": "gulp docs",
    "publish:patch": "gulp publish --yes --bump=patch",
    "publish:minor": "gulp publish --yes --bump=minor",
    "publish:major": "gulp publish --yes --bump=major",
    "publish:skip": "gulp publish --yes --bump=skip",
    "publish:release": "gulp release --yes --tag=beta"
  },
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
  },
  "keywords": [
    "sdk",
    "log"
  ],
  "author": "Jibo Inc. <info@jibo.com>",
  "maintainer": "Tim Garthwaite <tim.garthwaite@jibo.com>",
  "contributors": [
    "Tim Garthwaite <tim.garthwaite@jibo.com>",
    "Jon Ferguson <jon.ferguson@jibo.com>",
    "Avida Michaud <avida.michaud@jibo.com>"
  ],
  "license": "Copyright (C) 2016 Jibo, Inc.",
  "bugs": {
    "url": "https://github.jibo.com/sdk/jibo-log/issues"
  },
  "homepage": "https://github.jibo.com/sdk/jibo-log#readme",
  "devDependencies": {
    "gulp": "^3.9.1",
    "jibo-gulp": "^3.15.4"
  },
  "dependencies": {
    "format-error": "^1.0.0",
    "syslog-client": "^1.0.11"
  }
}
