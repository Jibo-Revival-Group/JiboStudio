    "jibo-anim-db": "^3.0.0",
    "jibo-attention-manager": "^3.0.1",
    "jibo-cai-utils": "^2.3.3",
    "jibo-client-framework": "^1.0.4",
    "jibo-common-types": "^1.0.0",
    "jibo-dof-arbiter": "^1.0.0",
    "jibo-emotion-system": "^2.0.0",
    "jibo-eventemitter3": "^1.3.1",
