{
  "name": "jibo",
  "version": "7.8.4",
  "description": "Runtime API for Jibo skills",
  "platform": ">=2.2.0",
  "main": "./lib/jibo.js",
  "typings": "dts/index.d.ts",
  "scripts": {
    "build": "gulp debug",
    "build:release": "gulp",
    "watch": "gulp watch",
    "test": "gulp test",
    "clean": "gulp clean-all",
