{
  "name": "jibo-cli",
  "version": "3.7.0",
  "description": "Command line interface, templates, simulator",
  "contributors": [
    "Jonathan Ross <jonathan@jibo.com>",
    "Francois Laberge <francoislaberge@gmail.com>",
    "Avida Michaud <avida.michaud@jibo.com>"
  ],
  "main": "./lib/jibo-cli.js",
  "bin": {
    "jibo": "./bin/jibo.js"
  },
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
  },
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "monorailConfig": {
    "output": [
      "lib",
      "simulator"
    ]
  },
  "scripts": {
    "build": "gulp debug",
    "postinstall": "node postinstall.js",
    "build:release": "gulp",
    "clean": "gulp clean-all",
    "watch": "gulp watch",
    "docs": "gulp docs",
    "publish:patch": "gulp publish --yes --bump=patch",
    "publish:minor": "gulp publish --yes --bump=minor",
    "publish:major": "gulp publish --yes --bump=major",
    "publish:skip": "gulp publish --yes --bump=skip",
    "publish:release": "gulp release --yes --tag=beta"
  },
  "peerDependencies": {},
  "dependencies": {
    "colors": "^1.1.2",
    "commander": "2.8.1",
    "compute-hamming": "^1.1.0",
    "prompt": "^0.2.14",
    "animation-utilities": "^2.0.0",
    "async": "0.9.0",
    "electron-prebuilt": "1.4.3",
    "cli-spinner": "^0.2.5",
    "ensureDir": "^1.0.6",
    "extract-zip": "^1.4.1",
    "find-root": "^1.0.0",
    "font-awesome": "^4.5.0",
    "fs-extra": "^0.26.5",
    "fs-plus": "2.9.3",
    "jibo-kb": "^5.0.0",
    "jibo-sync": "^1.0.0",
    "jibo-service-framework": "^1.0.0",
    "jibo-client-framework": "^1.0.4",
    "jquery": "^2.1.3",
    "lifesized": "^1.0.0",
    "lodash": "^3.8.0",
    "marked": "^0.3.5",
    "json-stable-stringify": "^1.0.0",
    "osenv": "^0.1.3",
    "react": "0.13.2",
    "resolve": "^1.1.7",
    "skills-service-manager": "^6.0.0",
    "uuid": "^2.0.1",
    "wrench": "^1.5.8",
    "ws-without-native": "^1.0.2"
  },
  "devDependencies": {
    "gulp": "^3.8.11",
    "gulp-less": "^3.0.5",
    "gulp-minify-css": "^1.2.3",
    "jibo-gulp": "^3.4.0"
  }
}
