{
  "name": "jibo-sync",
  "version": "2.0.0",
  "description": "Sync an entire a directory over HTTP; including incremental changes",
  "main": "./lib/jibo-sync.js",
  "scripts": {
    "test": "gulp test",
    "build": "gulp debug",
    "build:release": "gulp",
    "clean": "gulp clean-all",
    "watch": "gulp watch",
    "publish:patch": "gulp publish --yes --bump=patch",
    "publish:minor": "gulp publish --yes --bump=minor",
    "publish:major": "gulp publish --yes --bump=major",
    "publish:skip": "gulp publish --yes --bump=skip",
    "publish:release": "gulp release --yes --tag=beta"
  },
  "bin": {
    "jibo-sync": "./bin/jibo-sync.js"
  },
  "contributors": [
    "Avida Michaud <avida.michaud@jibo.com>",
    "Jon Ferguson <jon.fergusion@jibo.com>"
  ],
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
  },
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "dependencies": {
    "async": "^1.5.0",
    "chalk": "^1.1.3",
    "crypto": "0.0.3",
    "fs-extra": "^0.26.2",
    "get-port": "^3.0.0",
    "jibo-syncignore": "^2.0.0",
    "request": "^2.67.0",
    "stream-meter": "^1.0.3",
    "tar-fs": "^1.8.1"
  },
  "devDependencies": {
    "gulp": "^3.9.1",
    "jibo-gulp": "^4.0.0"
  }
}
