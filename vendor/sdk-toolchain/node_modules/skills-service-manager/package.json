{
  "name": "skills-service-manager",
  "version": "6.0.0",
  "description": "Skills Services Manager",
  "main": "index.js",
  "scripts": {
    "build": "gulp debug",
    "build:release": "gulp",
    "test": "gulp test",
    "clean": "gulp clean-all",
    "watch": "gulp watch",
    "optional": "npm install \"@jibo/jibo-server-client@~3.0.0\"",
    "postinstall": "npm run optional && parser-download -r",
    "robot": "./bin/run-on-robot.sh",
    "addsshkey": "./bin/utils/add-ssh-key.sh",
    "publish:patch": "gulp publish --yes --bump=patch",
    "publish:minor": "gulp publish --yes --bump=minor",
    "publish:major": "gulp publish --yes --bump=major",
    "publish:skip": "gulp publish --yes --bump=skip",
    "publish:release": "gulp release --yes --tag=beta"
  },
  "scriptsRelease": {
    "postinstall": "parser-download -r"
  },
  "monorailConfig": {
    "output": [
      "lib",
      "static/performance",
      "static/skills-service",
      "static/error-service"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
  },
  "author": "",
  "license": "ISC",
  "parser": {
    "version": "2.4.0",
    "type": "50"
  },
  "dependencies": {
    "animation-utilities": "^2.0.0",
    "async": "^1.5.2",
    "body-parser": "^1.15.0",
    "connect": "^3.4.1",
    "find-root": "^1.0.0",
    "fs-extra": "^0.30.0",
    "jibo": "^7.0.0",
    "jibo-common-types": "^1.0.0",
    "jibo-log": "^2.0.0",
    "jibo-node-xml": "^4.3.0",
    "jibo-service-framework": "^1.0.0",
    "jibo-state-machine": "^4.0.0",
    "jibo-sync": "^1.0.0",
    "jibo-typed-events": "^3.1.0",
    "jimp": "^0.2.24",
    "md5": "^2.2.1",
    "mime": "^1.3.4",
    "mkdirp": "^0.5.1",
    "node-schedule": "^1.2.0",
    "orchestrator": "^0.3.7",
    "parser-download": "^2.0.0",
    "request": "^2.71.0",
    "rimraf": "^2.5.4",
    "router": "^1.1.4",
    "rule-generator": "^2.0.0",
    "semver": "^5.0.3",
    "serve-static": "^1.10.2",
    "tcp-proxy": "0.0.1",
    "uuid": "^2.0.2",
    "ws-without-native": "^1.0.2",
    "jibo-syncignore": "^1.0.0",
    "tar-fs": "^1.8.1"
  },
  "optionalDependencies": {
    "@jibo/jibo-server-client": "~3.0.0"
  },
  "devDependencies": {
    "electron-prebuilt": "1.4.3",
    "floss": "^1.1.0",
    "gulp": "^3.9.1",
    "jibo-gulp": "^3.0.0",
    "jquery": "^3.1.0",
    "should": "^11.1.0"
  }
}
